# ── JEMPE Admin — Variables de entorno requeridas ─────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA debe subirse a Git.

# Base de datos
# Desarrollo local (H2):
DB_URL=jdbc:h2:mem:jempedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=MSSQLServer
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# Producción (PostgreSQL en Render — Render lo provee automáticamente):
# DB_URL=jdbc:postgresql://<host>:<port>/<dbname>
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=<usuario>
# DB_PASSWORD=<password>

# Usuarios del sistema
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esto_en_produccion
ENTRENADOR_USER=nombre_entrenador
ENTRENADOR_PASSWORD=cambia_esto_en_produccion

# Servidor
PORT=8080
H2_CONSOLE_ENABLED=true
JPA_DDL_AUTO=update
